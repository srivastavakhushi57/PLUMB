# PLUMB Backend Environment Variables

# Demo Mode (true: SQLite + built-in demo auth, false: PostgreSQL + Supabase)
DEMO_MODE=true

# Database Connection (used if DEMO_MODE=false)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/plumb

# JWT Authentication
SECRET_KEY=plumb-demo-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
# Options: "gemini", "mock" (default: "gemini" if GEMINI_API_KEY is provided, else "mock")
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Host and Port
HOST=127.0.0.1
PORT=8000
